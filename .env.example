# Optional: enables the AI Mahjong Coach. The game works fully without it.
# Keep this server-side only. Never prefix with VITE_ (that would expose it to the browser).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-haiku-5-5 for fast, inexpensive tips)
ANTHROPIC_MODEL=claude-haiku-5-5
# Port for the local coach API server (Vite proxies /api to it)
COACH_PORT=8787
